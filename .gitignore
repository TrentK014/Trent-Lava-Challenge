# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node
node_modules/

# Next.js
.next/
out/

# Env and secrets
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testing & coverage
coverage/

# Build artifacts
*.log
*.cache

# Uploads (keep public/uploads/, but ignore transient files if any)
public/uploads/*.tmp

# Supabase local configs
.supabase/

# Misc
*.swp
*.swo
